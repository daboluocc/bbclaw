# Cloud transport overlay（叠在 sdkconfig.defaults + boards/<name>/sdkconfig.board 之后）:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/<name>/sdkconfig.board;sdkconfig.cloud" build
# 与 sdkconfig.bbclaw.latest 的 Transport 段保持一致。
# CONFIG_BBCLAW_TRANSPORT_PROFILE_LOCAL_HOME is not set
# CONFIG_BBCLAW_TRANSPORT_PROFILE_LOCAL_HOME_V2 is not set
CONFIG_BBCLAW_TRANSPORT_PROFILE_CLOUD_SAAS=y
CONFIG_BBCLAW_CLOUD_BASE_URL="http://bbclaw.daboluo.cc"
CONFIG_BBCLAW_ENABLE_TTS_PLAYBACK=y
CONFIG_BBCLAW_ENABLE_DISPLAY_PULL=y
