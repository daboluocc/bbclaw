# 嘉立创·实战派 ESP32-S3 板级 sdkconfig 覆盖
# make set-board BOARD=lichuang-szp 会把本文件逐行覆盖进 sdkconfig；
# 独立构建可用 SDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/lichuang-szp/sdkconfig.board"

CONFIG_BBCLAW_BOARD_LICHUANG_SZP=y
# CONFIG_BBCLAW_BOARD_BBCLAW is not set
# CONFIG_BBCLAW_BOARD_BREADBOARD is not set
# CONFIG_BBCLAW_BOARD_ATK_DNESP32S3_BOX is not set
# CONFIG_BBCLAW_BOARD_WS_AMOLED_206 is not set

# WROOM-1 N16R8: 8MB Octal PSRAM（sdkconfig.defaults 全局默认 QUAD，
# 不切会 "wrong PSRAM line mode" boot loop）
CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_MODE_QUAD is not set

# Flash 16MB(esptool flash_id 实证 0x46/0x4018,MAC 30:ed:a0:a8:44:e0);DIO。
# ⚠️ 别的 S3 板多为 8MB——16MB 镜像头刷到 8MB 板会 spi_flash 探测失败无限重启,
# 烧录前先核对 MAC/flash_id 再动手。
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_8MB is not set
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# CONFIG_ESPTOOLPY_FLASHMODE_QIO is not set

# 16MB 专属分区表：app 槽 4MB，容得下带 esp32-camera 的固件（ADR-049）。
# 8MB 生产板的 partitions_ota.csv（2.5MB 槽）装不下摄像头固件。
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/lichuang-szp/partitions_16mb.csv"

# 摄像头 DMA 缓冲上限降到 8KB（默认 32KB）：运行时内部 DRAM 只剩 ~19KB，默认
# 30KB DMA 缓冲 malloc 失败（cam_dma_config failed）。8KB→DMA 缓冲 ~7.6KB 可塞下，
# 一次性拍照 DMA 周期多一点无妨。帧缓冲仍在 PSRAM，不吃内部堆。（ADR-049）
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=8192

# mbedtls 走 PSRAM（与 sdkconfig.bbclaw.latest 生产配置一致）。默认 INTERNAL 时
# TLS 每次握手要 ~40KB 连续内部堆，运行一段时间后必现 -0x7F00 alloc 失败 →
# healthz/心跳全挂，屏上误报 CLOUD ERR/adapter offline（真机踩过）
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
# CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC is not set

# 硬件 AES 走 DMA，要 DMA-capable 的内部 DRAM。本板内部 DRAM 极紧（运行时 ~19KB），
# 拍照占用一轮 + 云 WS 长连的 TLS，再叠一条 TTS 合成 HTTPS 的 esp-aes DMA 分配就 OOM
# （日志 `esp-aes: Failed to allocate memory` → `notif-tts: synth empty/failed` → 没声音，
# ADR-049 真机实测）。改用软件 AES：纯计算、不吃内部 DMA 缓冲，从根上消除该 OOM。本设备
# TLS 吞吐很低（音频 ~256kbps、TTS 偶发），软件 AES 的 CPU 开销可忽略。仅本相机板生效。
# CONFIG_MBEDTLS_HARDWARE_AES is not set
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
