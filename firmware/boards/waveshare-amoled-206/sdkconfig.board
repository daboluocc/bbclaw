# Waveshare ESP32-S3-Touch-AMOLED-2.06 板级 sdkconfig 覆盖（ADR-040 §7）
# make set-board BOARD=waveshare-amoled-206 会把本文件逐行覆盖进 sdkconfig；
# 独立构建可用 SDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/waveshare-amoled-206/sdkconfig.board"

CONFIG_BBCLAW_BOARD_WS_AMOLED_206=y
# CONFIG_BBCLAW_BOARD_BBCLAW is not set
# CONFIG_BBCLAW_BOARD_BREADBOARD is not set
# CONFIG_BBCLAW_BOARD_ATK_DNESP32S3_BOX is not set

# 叠封 PSRAM 是 Octal（sdkconfig.defaults 全局默认 QUAD，不切会 boot loop:
# "wrong PSRAM line mode"）
CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_MODE_QUAD is not set

# Flash: wiki 标称 32MB，官方 demo 按 16MB QIO 配置（实测 flash_id 后可再调大）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_8MB is not set
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# CONFIG_ESPTOOLPY_FLASHMODE_DIO is not set

# SD 卡录音(ADR-044):FATFS 长文件名(默认 8.3 短名,10 位 epoch 目录名与
# .opus 扩展名都超限,mkdir/fopen 静默失败)。堆分配 LFN 缓冲,每打开文件 ~(255+1)*2B
# LFN 改栈缓冲(排障):堆投毒下 fclose 必崩(crumb=4,堆完整性检查全过),
# fclose 与已验证 OK 的 fsync 唯一差异=释放 LFN 堆缓冲。栈缓冲 512B,
# recorder_task 16KB 栈余量充足
CONFIG_FATFS_LFN_STACK=y

# SD 卡与 UART0 引脚冲突(本板 SD: CMD=GPIO1/D0=GPIO3 恰是 UART0 TX/RX):
# 控制台留在 UART0 会持续驱动 GPIO1,SD 写操作 errno=5(EIO)。日志本就走
# TinyUSB CDC0 vprintf tee(bb_device_monitor),关 UART0 控制台无损失。
CONFIG_ESP_CONSOLE_NONE=y

# 栈底硬件观察点(暂关,2026-07-05 深夜):开启后设备在录音中/空闲态随机
# panic(crumb=8/空闲重启)——疑似暴露了某个长期贴栈边运行的老任务(watchpoint
# 一蹭就炸,此前静默无害)。P1a 录音栈账已修完;找到贴边任务前先回到关闭
# 现状(与之前几个月一致)。排障时可临时打开。
# CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# ── CPU/系统级低功耗(ADR-047):自动 light sleep + DFS ──────────────────────
# 息屏进 SLEEPING 后 SoC 在 WiFi beacon 间隙 light-sleep;WiFi modem-sleep 维持关联
# → 云端 push 照常唤醒(消息唤醒不变)。deep sleep 不做(会断连丢 push)。运行时由
# bb_pm 显式 esp_pm_configure(240↔80MHz, light_sleep_enable) + NO_LIGHT_SLEEP 交互锁。
# 仅本手表板打开;bbclaw 量产板不含这些行,OTA 零影响。
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_DFS_INIT_AUTO=y
# 保守:light sleep 里不断 CPU 电(与 Octal PSRAM + QSPI LCD 共存更稳),仅时钟门控。
# CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP is not set
# WiFi 关联态 beacon 间隙进 modem-sleep(维持连接的前提)。
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
